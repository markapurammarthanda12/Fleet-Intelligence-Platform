API_PORT=8080
DASHBOARD_PORT=3000
POSTGRES_PORT=5432
KAFKA_PORT=9092
POSTGRES_DB=fleetintel
POSTGRES_USER=fleetintel
# Local demonstration value only. Set a strong secret outside this file for shared deployments.
POSTGRES_PASSWORD=fleetintel_local_only
IDLE_ALERT_SECONDS=300
IDLE_CRITICAL_SECONDS=900
FUEL_LITRES_PER_IDLE_HOUR=1.5
# Single-node local broker settings. Use replication factor 3 and min ISR 2 in a replicated cluster.
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_MIN_ISR=1
KAFKA_CONSUMER_CONCURRENCY=4
KAFKA_MAX_POLL_RECORDS=500
KAFKA_RETRY_ATTEMPTS=5
KAFKA_PRODUCER_ACK_TIMEOUT_MS=2000
# Local Compose defaults to an unauthenticated developer demo.
FLEET_SECURITY_ENABLED=false
# Set when enabling hosted OAuth2/OIDC mode.
OIDC_ISSUER_URI=

# Local demo only. Replace for any shared environment.
CLICKHOUSE_USER=fleetintel
CLICKHOUSE_PASSWORD=fleetintel_local_only
